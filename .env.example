# Non-secret, client-visible configuration (safe to publish)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side only. Set these as project secrets, never in a committed file.
# PI_NETWORK controls Mainnet vs Testnet and is the ONLY place the network is
# decided — the browser never chooses it. Production must be "mainnet".
# PI_NETWORK=mainnet
# PI_API_KEY=            # Pi Developer Portal server API key
# PI_LOGIN_SECRET=       # internal key used to derive Pi-only account credentials
# PI_WALLET_PRIVATE_SEED= # App wallet seed for App-to-User payouts (server only)
